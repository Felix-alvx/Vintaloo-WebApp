@model Application.DTOs.ArticuloDTO

@{
    ViewData["Title"] = "Eliminar artículo";
    Layout = "_PanelLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Eliminar artículo</h1>
        <p class="subtitle">Esta acción no se puede deshacer.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

<div class="card">
    <p>¿Seguro que deseas eliminar <strong>@Model.Titulo</strong>?</p>
    <form asp-action="EliminarConfirmado" asp-route-id="@Model.IdArticulo" method="post" style="margin-top:1.25rem">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger" type="submit">Eliminar artículo</button>
    </form>
</div>

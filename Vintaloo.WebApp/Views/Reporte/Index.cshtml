@model List<Domain.Data.Reporte>

@{
    ViewData["Title"] = "Reportes";
    Layout = "_PanelLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Reportes</h1>
        <p class="subtitle">Revisa los reportes enviados por los usuarios.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear">Nuevo reporte</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <p class="empty">No hay reportes registrados.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Artículo</th>
                        <th>Usuario</th>
                        <th>Motivo</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reporte in Model)
                    {
                        <tr>
                            <td>@reporte.IdReporte</td>
                            <td>#@reporte.IdArticulo</td>
                            <td>#@reporte.IdUsuario</td>
                            <td>
                                <strong>@reporte.Motivo</strong>
                                @if (!string.IsNullOrWhiteSpace(reporte.Descripcion))
                                {
                                    <div class="muted">@reporte.Descripcion</div>
                                }
                            </td>
                            <td>@(reporte.FechaReporte?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td><span class="badge">@(reporte.Estado ?? "pendiente")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

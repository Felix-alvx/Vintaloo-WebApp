@model Application.DTOs.CreateCategoriaDTO

@{
    ViewData["Title"] = "Nueva categoría";
    Layout = "_PanelLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Nueva categoría</h1>
        <p class="subtitle">Agrega una categoría para organizar los artículos.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

<div class="card">
    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label class="form-label" asp-for="Nombre"></label>
            <input class="form-control" asp-for="Nombre" />
            <span class="field-validation-error" asp-validation-for="Nombre"></span>
        </div>
        <div class="form-group">
            <label class="form-label" asp-for="Descripcion"></label>
            <textarea class="form-control" asp-for="Descripcion" rows="3"></textarea>
            <span class="field-validation-error" asp-validation-for="Descripcion"></span>
        </div>
        <button class="btn btn-primary" type="submit">Guardar categoría</button>
    </form>
</div>

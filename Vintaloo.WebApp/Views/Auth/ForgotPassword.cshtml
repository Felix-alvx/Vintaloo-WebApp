@model Application.DTOs.ForgotPasswordDTO

@{
    ViewData["Title"] = "Recuperar contraseña — Vintaloo";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --cream: #F2EDE4; --terra: #C05A35; --terra-dk: #9A4428; --ink: #1C1814; --muted: #8A7E74; --border: #DDD5C8; --error: #C0392B; }
        body { min-height: 100vh; background: var(--cream); color: var(--ink); font-family: 'DM Sans', sans-serif; display: flex; flex-direction: column; }
        nav { height: 56px; padding: 0 2rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
        .brand { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--ink); text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .brand-icon { width: 30px; height: 30px; border-radius: 7px; background: var(--terra); }
        nav a { color: var(--muted); text-decoration: none; font-size: 0.82rem; }
        main { width: min(430px, calc(100% - 2rem)); margin: auto; padding: 3rem 0; }
        .card { background: #FDFAF6; border: 1px solid var(--border); border-radius: 14px; padding: 2rem; }
        h1 { font-family: 'Playfair Display', serif; font-size: 1.6rem; margin-bottom: 0.5rem; }
        p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; text-transform: uppercase; letter-spacing: 0.07em; font-size: 0.72rem; font-weight: 600; color: var(--muted); margin-bottom: 5px; }
        input { width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 8px; background: #fff; font-family: inherit; font-size: 0.9rem; }
        input:focus { outline: none; border-color: var(--terra); }
        .btn { width: 100%; padding: 12px; border: 0; border-radius: 8px; background: var(--terra); color: #fff; font-family: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer; }
        .btn:hover { background: var(--terra-dk); }
        .error { color: var(--error); font-size: 0.8rem; margin-top: 0.3rem; display: block; }
        .validation { color: var(--error); font-size: 0.8rem; margin-bottom: 1rem; }
        .validation ul { margin-left: 1rem; }
        .back { text-align: center; margin-top: 1rem; font-size: 0.82rem; }
        .back a { color: var(--terra); text-decoration: none; }
    </style>
</head>
<body>
    <nav>
        <a class="brand" href="/Auth/Login"><span class="brand-icon"></span>Vintaloo</a>
        <a href="/Auth/Login">Volver a iniciar sesión</a>
    </nav>
    <main>
        <div class="card">
            <h1>Recuperar contraseña</h1>
            <p>Escribe el correo de tu cuenta y te enviaremos un enlace para restablecerla.</p>
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation" asp-validation-summary="All"></div>
                }
                <div class="form-group">
                    <label asp-for="Correo"></label>
                    <input asp-for="Correo" type="email" autocomplete="email" />
                    <span class="error" asp-validation-for="Correo"></span>
                </div>
                <button class="btn" type="submit">Enviar enlace</button>
            </form>
            <div class="back"><a href="/Auth/Login">Volver al inicio de sesión</a></div>
        </div>
    </main>
</body>
</html>

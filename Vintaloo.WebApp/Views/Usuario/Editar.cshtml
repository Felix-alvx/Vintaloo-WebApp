@model Application.DTOs.UpdateUsuarioDTO

@{
    ViewData["Title"] = "Editar usuario";
    Layout = "_PanelLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Editar usuario</h1>
        <p class="subtitle">Actualiza los datos, el rol y el estado de la cuenta.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

<div class="card">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdUsuario" />
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" />
                <span class="field-validation-error" asp-validation-for="Nombre"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Telefono"></label>
                <input class="form-control" asp-for="Telefono" />
                <span class="field-validation-error" asp-validation-for="Telefono"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Ubicacion"></label>
                <input class="form-control" asp-for="Ubicacion" />
                <span class="field-validation-error" asp-validation-for="Ubicacion"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Estado"></label>
                <select class="form-control" asp-for="Estado">
                    <option value="activo">Activo</option>
                    <option value="bloqueado">Bloqueado</option>
                </select>
                <span class="field-validation-error" asp-validation-for="Estado"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="IdRol">Rol</label>
                <select class="form-control" asp-for="IdRol">
                    <option value="2">Usuario</option>
                    <option value="1">Administrador</option>
                </select>
                <span class="field-validation-error" asp-validation-for="IdRol"></span>
            </div>
        </div>
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
    </form>
</div>

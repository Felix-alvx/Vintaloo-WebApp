@model Application.DTOs.CreateUsuarioDTO

@{
    ViewData["Title"] = "Nuevo usuario";
    Layout = "_PanelLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Nuevo usuario</h1>
        <p class="subtitle">Crea una cuenta y asigna su rol.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

<div class="card">
    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" />
                <span class="field-validation-error" asp-validation-for="Nombre"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Correo"></label>
                <input class="form-control" asp-for="Correo" type="email" />
                <span class="field-validation-error" asp-validation-for="Correo"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Telefono"></label>
                <input class="form-control" asp-for="Telefono" />
                <span class="field-validation-error" asp-validation-for="Telefono"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Ubicacion"></label>
                <input class="form-control" asp-for="Ubicacion" />
                <span class="field-validation-error" asp-validation-for="Ubicacion"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                <span class="field-validation-error" asp-validation-for="Password"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="IdRol">Rol</label>
                <select class="form-control" asp-for="IdRol">
                    <option value="2">Usuario</option>
                    <option value="1">Administrador</option>
                </select>
                <span class="field-validation-error" asp-validation-for="IdRol"></span>
            </div>
        </div>
        <button class="btn btn-primary" type="submit">Crear usuario</button>
    </form>
</div>

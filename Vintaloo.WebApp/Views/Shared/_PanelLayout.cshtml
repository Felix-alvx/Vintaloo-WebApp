@{
    var esAdmin = User.IsInRole("admin");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vintaloo</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --cream: #F2EDE4;
            --warm: #EDE5D8;
            --terra: #C05A35;
            --terra-dk: #9A4428;
            --ink: #1C1814;
            --muted: #8A7E74;
            --border: #DDD5C8;
            --success: #4A7C59;
            --error: #C0392B;
            --card: #FDFAF6;
        }
        body { background: var(--cream); color: var(--ink); font-family: 'DM Sans', sans-serif; min-height: 100vh; }
        nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 2rem; min-height: 56px; border-bottom: 1px solid var(--border); background: var(--cream); flex-wrap: wrap; }
        .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
        .nav-logo-icon { width: 30px; height: 30px; background: var(--terra); border-radius: 7px; }
        .nav-logo-text { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; }
        .nav-links { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
        .nav-links a, .nav-links button { color: var(--muted); text-decoration: none; font-size: 0.82rem; background: none; border: 0; cursor: pointer; font-family: inherit; }
        .nav-links a:hover, .nav-links button:hover { color: var(--terra); }
        .container { width: min(1080px, calc(100% - 2rem)); margin: 2rem auto; }
        .page-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
        .page-title { font-family: 'Playfair Display', serif; font-size: 1.65rem; font-weight: 600; }
        .subtitle { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
        .alert { border-radius: 8px; padding: 0.8rem 1rem; margin-bottom: 1rem; font-size: 0.9rem; }
        .alert-success { background: #EDF6EF; color: var(--success); border: 1px solid #BFDCC7; }
        .alert-error { background: #FBECEA; color: var(--error); border: 1px solid #EDC1BB; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { padding: 0.75rem 0.6rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: middle; }
        th { color: var(--muted); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
        tr:last-child td { border-bottom: 0; }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; padding: 0.55rem 0.9rem; border-radius: 8px; border: 1px solid transparent; font-family: inherit; font-size: 0.82rem; font-weight: 500; text-decoration: none; cursor: pointer; }
        .btn-primary { background: var(--terra); color: #fff; }
        .btn-primary:hover { background: var(--terra-dk); }
        .btn-secondary { background: var(--warm); color: var(--ink); border-color: var(--border); }
        .btn-danger { background: #A93226; color: #fff; }
        .btn-sm { padding: 0.35rem 0.65rem; font-size: 0.78rem; }
        .actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
        .form-group { margin-bottom: 1rem; }
        .form-label { display: block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.35rem; }
        .form-control { width: 100%; padding: 0.7rem 0.8rem; border: 1.5px solid var(--border); border-radius: 8px; background: #fff; font-family: inherit; font-size: 0.9rem; color: var(--ink); }
        .form-control:focus { outline: none; border-color: var(--terra); }
        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .full { grid-column: 1 / -1; }
        .field-validation-error, .validation-summary-errors { color: var(--error); font-size: 0.8rem; }
        .validation-summary-errors ul { margin-left: 1rem; }
        .badge { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; background: var(--warm); color: var(--muted); }
        .badge-admin { background: #F6E3D9; color: var(--terra-dk); }
        .badge-active { background: #EDF6EF; color: var(--success); }
        .badge-inactive { background: #FBECEA; color: var(--error); }
        .empty { color: var(--muted); text-align: center; padding: 2rem 1rem; }
        .muted { color: var(--muted); }
        .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .detail-item { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 0.8rem; }
        .detail-label { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.25rem; }
        @@media (max-width: 700px) { .form-grid, .detail-grid { grid-template-columns: 1fr; } nav { padding: 0.75rem 1rem; } .container { margin-top: 1.25rem; } }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav>
        <a class="nav-logo" href="/Dashboard">
            <span class="nav-logo-icon"></span>
            <span class="nav-logo-text">Vintaloo</span>
        </a>
        <div class="nav-links">
            <a href="/Dashboard">Inicio</a>
            <a href="/Articulo">Artículos</a>
            <a href="/Usuario/Perfil">Mi perfil</a>
            <a href="/Favorito">Favoritos</a>
            @if (esAdmin)
            {
                <a href="/Categoria">Categorías</a>
                <a href="/Reporte">Reportes</a>
                <a href="/Usuario">Usuarios</a>
            }
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">Cerrar sesión</button>
            </form>
        </div>
    </nav>

    <main class="container">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <div asp-validation-summary="All"></div>
            </div>
        }
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
